# MicroViber daemon config (copied to .env; never commit the real .env)
MV_BIND_ADDRESS=127.0.0.1          # tailnet IP in real use; never 0.0.0.0
MV_PORT=8730
MV_BEARER_TOKEN=                    # leave empty: auto-generated + saved to ~/.microviber/token on first run
MV_ALLOWED_HOSTS=                   # comma-separated Host allowlist (DNS-rebinding guard)
MV_ALLOWED_ORIGINS=                 # comma-separated CORS/WS Origin allowlist
MV_VAPID_PUBLIC_KEY=
MV_VAPID_PRIVATE_KEY=
MV_CLAUDE_BIN=claude               # path to the claude binary for owned mode
